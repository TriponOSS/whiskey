// whiskey/route.tp - static routes + :param capture.
//
// No fn pointers exist in Tripon v0, so there is no handler table: the user
// owns one match on (method, path) and whiskey gives them the matchers.
//
//   if whiskey_method_is(req, whiskey_get()) { ... }
//   let m = whiskey_route(req, "/users/:id")?;
//   let id = whiskey_param_i32(req, m, 0)?;   // opt<i32>, match or ?
//
// Param byte spans are recorded as (start,end) pairs over the request path;
// whiskey_param_... slices them back out.

use tier core;

// method ordinals, same values as http.tp parse. public API: v0 has no
// top-level consts, so these are niladic fns ("universal zero cost" still:
// the compiler inlines them, see ralt -O fast).
fn whiskey_get() -> i32 { return 0; }
fn whiskey_post() -> i32 { return 1; }
fn whiskey_put() -> i32 { return 2; }
fn whiskey_delete() -> i32 { return 3; }
fn whiskey_other() -> i32 { return 9; }

// captured spans: up to 3 params per pattern, spans into req path bytes.
struct Match {
    n: i32;            // how many params hit (0..=3)
    s0: i32;
    e0: i32;
    s1: i32;
    e1: i32;
    s2: i32;
    e2: i32;
}

// find next '/', ' ' or '?' in the wire bytes (used by query-stripping later).
fn seg_end(b: Buf, at: i32) -> i32 {
    let i = at;
    while i < b.n {
        if b.data[i] == cast<i8>(47) || b.data[i] == cast<i8>(32) || b.data[i] == cast<i8>(63) {
            return i;
        }
        i += 1;
    }
    return b.n;
}

// is the pattern byte a ':' opener of a ":name" segment?
fn pat_is_param(pattern: str, pat: i32, pe: i32) -> bool {
    return pe - pat >= 1 && cast<i8>(pattern[pat]) == cast<i8>(58);
}

// static-segment byte compare: req bytes [bat..bend) vs pattern [pat..pend).
fn seg_static_eq(b: Buf, bat: i32, bend: i32, pattern: str, pat: i32, pend: i32) -> bool {
    if bend - bat != pend - pat {
        return false;
    }
    let k = 0;
    while k < pend - pat {
        if b.data[bat + k] != cast<i8>(pattern[pat + k]) {
            return false;
        }
        k += 1;
    }
    return true;
}

// match a request path against a pattern like "/users/:id/posts/:pid".
// some(m) = shape matched. none = different shape.
fn whiskey_route(req: Request, pattern: str) -> opt<Match> {
    let b: Buf;
    b = req.data;
    let bstart = req.pstart;
    let bend = req.pend;
    let plen = len(pattern);
    if plen < 1 || cast<i8>(pattern[0]) != cast<i8>(47) {
        return none;
    }
    let m: Match;
    let bi = bstart + 1;      // skip leading '/'
    let pi = 1;               // skip leading '/'
    let slot = 0;
    // empty-ish pattern "/": matches only empty path? "/" wires: pstart..pend = "/"
    if plen == 1 {
        if bend <= bstart + 1 {
            return some(m);
        }
        return none;
    }
    while pi < plen {
        // pattern segment: pattern[pi .. pe)
        let pe = pi;
        while pe < plen && cast<i8>(pattern[pe]) != cast<i8>(47) {
            pe += 1;
        }
        // path segment: b[bi .. be)
        let be = bi;
        while be < bend && b.data[be] != cast<i8>(47) {
            be += 1;
        }
        let isparam = pat_is_param(pattern, pi, pe);
        if isparam {
            if be == bi {
                return none;   // ":name" cannot capture empty
            }
            if slot == 0 {
                m.s0 = bi;
                m.e0 = be;
                m.n = 1;
                slot = 1;
            } else if slot == 1 {
                m.s1 = bi;
                m.e1 = be;
                m.n = 2;
                slot = 2;
            } else if slot == 2 {
                m.s2 = bi;
                m.e2 = be;
                m.n = 3;
                slot = 3;
            } else {
                return none;
            }
        } else {
            if !seg_static_eq(b, bi, be, pattern, pi, pe) {
                return none;
            }
        }
        bi = be;
        pi = pe;
        // both move past the separator together
        if pi < plen || bi < bend {
            if pi >= plen {
                // pattern consumed, wire path has more segments
                return none;
            }
            if bi >= bend {
                // wire gone, pattern still has segments: pattern tail must be
                // all-static-absent -> no (patterns must match exactly)
                return none;
            }
            if b.data[bi] != cast<i8>(47) || cast<i8>(pattern[pi]) != cast<i8>(47) {
                return none;
            }
            bi += 1;
            pi += 1;
        }
    }
    // pattern consumed. wire consumed too?
    if bi < bend {
        return none;
    }
    return some(m);
}

// digits param, most common shape (/users/:id). none if empty/non-numeric.
fn whiskey_param_i32(req: Request, m: Match, idx: i32) -> opt<i32> {
    let at = 0;
    let end = 0;
    if idx == 0 {
        at = m.s0;
        end = m.e0;
    } else if idx == 1 {
        at = m.s1;
        end = m.e1;
    } else if idx == 2 {
        at = m.s2;
        end = m.e2;
    } else {
        return none;
    }
    if at >= end || end > req.pend {
        return none;
    }
    let b: Buf;
    b = req.data;
    let v = 0;
    let i = at;
    let neg = false;
    if b.data[i] == cast<i8>(45) && i + 1 < end {
        neg = true;
        i += 1;
    }
    while i < end {
        let c = b.data[i];
        if c < cast<i8>(48) || c > cast<i8>(57) {
            return none;
        }
        v = v * 10 + cast<i32>(c - cast<i8>(48));
        i += 1;
    }
    if neg {
        v = 0 - v;
    }
    return some(v);
}

// quick tell: is the wire method the one this route wants?
fn whiskey_method_is(req: Request, m: i32) -> bool {
    return req.method == m;
}
